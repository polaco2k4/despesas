# SQL Server Configuration
SQL_SERVER=localhost\\SQLEXPRESS
SQL_DATABASE=DESPESAS
SQL_TRUSTED_CONNECTION=true
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

# Server Configuration
PORT=3001
NODE_ENV=development

# Utilizador e senha pedidos ao abrir a API diretamente no browser
# (deixar vazio para desativar)
API_DOCS_USER=admin
API_DOCS_PASSWORD=mudar_esta_senha

# CORS Configuration (frontend URL)
FRONTEND_URL=http://localhost:5173

# Active Directory Configuration
AD_SERVER=your-domain-controller.company.com
AD_PORT=389
AD_DOMAIN=company.com
# Raiz do domínio: a pesquisa é recursiva (scope sub), apanha todas as OUs
AD_BASE_DN=DC=company,DC=com
# Opcional: URL completo (recomendado LDAPS para não enviar senhas em claro)
# AD_URL=ldaps://your-domain-controller.company.com:636
# AD_TLS_REJECT_UNAUTHORIZED=false   # só se o certificado do DC não for confiável
# AD_TIMEOUT_MS=5000
AD_ADMIN_USER=admin@company.com
AD_ADMIN_PASSWORD=admin_password

# ID (GUID) do departamento de Planeamento - o gestor deste departamento aprova o nivel 2 das despesas
PLANEAMENTO_DEPARTAMENTO_ID=

# Segredo usado para assinar os tokens de sessão (gerar um valor aleatório longo)
JWT_SECRET=
# Duração da sessão em horas (por omissão 12)
# AUTH_TOKEN_TTL_HOURS=12
